{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "developer-farm: build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "developer-farm: watch extension",
      "type": "npm",
      "script": "dev:extension",
      "isBackground": true,
      "presentation": { "reveal": "never", "group": "developer-farm-dev" },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^✘ \\[ERROR\\] (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    },
    {
      "label": "developer-farm: vite dev server",
      "type": "npm",
      "script": "dev:webview",
      "isBackground": true,
      "presentation": { "reveal": "never", "group": "developer-farm-dev" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "developer-farm: assets",
      "type": "npm",
      "script": "assets",
      "problemMatcher": []
    },
    {
      "label": "developer-farm: dev",
      "dependsOn": ["developer-farm: assets", "developer-farm: watch extension", "developer-farm: vite dev server"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
